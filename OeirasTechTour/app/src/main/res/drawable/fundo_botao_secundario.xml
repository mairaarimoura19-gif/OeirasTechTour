    Seletor responsável por definir o fundo do botão de controle de áudio.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/cor_fundo_suave" />
            <stroke
                android:width="2dp"
                android:color="@color/cor_dourado_logo_escuro" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/cor_superficie" />
            <stroke
                android:width="2dp"
                android:color="@color/cor_dourado_logo" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
